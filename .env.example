# Copy this file to ".env" and paste your key after the = sign.
# You only need the key for the provider set in config.yaml ("provider:").

# Anthropic (Claude): https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# OpenAI (GPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
